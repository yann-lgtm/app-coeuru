{
  "expo": {
    "name": "Lecteur",
    "slug": "lecteur",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.coeuru.lecteur",
      "infoPlist": {
        "CFBundleDisplayName": "Lecteur",
        "UIBackgroundModes": [
          "audio"
        ],
        "NSLocalNetworkUsageDescription": "Lecteur se connecte à ton Mac sur le Wi-Fi pour copier tes morceaux.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": false,
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Audio",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.audio",
              "public.mp3",
              "com.microsoft.waveform-audio"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.coeuru.lecteur",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0B0D"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-audio",
      "expo-asset",
      "expo-status-bar"
    ]
  }
}
